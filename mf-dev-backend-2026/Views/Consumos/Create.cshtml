@model mf_dev_backend_2026.Models.Consumo

@{
    ViewData["Title"] = "Criar Consumo";
}

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <h1 class="fw-bold">Criar Consumo</h1>
        <p class="text-muted">
            Preencha as informações do consumo e selecione o veículo relacionado.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0">Informações do consumo</h5>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Descricao" class="form-label"></label>
                        <input asp-for="Descricao" class="form-control" />
                        <span asp-validation-for="Descricao"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Data" class="form-label"></label>
                        <input asp-for="Data" type="date" class="form-control" />
                        <span asp-validation-for="Data"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Valor" class="form-label"></label>
                        <input asp-for="Valor"
                               type="number"
                               step="0.01"
                               class="form-control" />
                        <span asp-validation-for="Valor"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="km" class="form-label"></label>
                        <input asp-for="km"
                               type="number"
                               class="form-control" />
                        <span asp-validation-for="km"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TipoCombustivel" class="form-label"></label>
                        <select asp-for="TipoCombustivel"
                                asp-items="Html.GetEnumSelectList<mf_dev_backend_2026.Models.TipoCombustivel>()"
                                class="form-select">
                        </select>
                        <span asp-validation-for="TipoCombustivel"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="VeiculoId" class="form-label"></label>
                        <select asp-for="VeiculoId"
                                asp-items="ViewBag.VeiculoId"
                                class="form-select">
                            <option value="">Selecione um veículo</option>
                        </select>
                        <span asp-validation-for="VeiculoId"
                              class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-success">
                        Salvar Consumo
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Voltar para a lista
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
