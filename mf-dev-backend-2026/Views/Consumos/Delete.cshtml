@{
    ViewData["Title"] = "Apagar Consumo";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h1 class="fw-bold">Apagar Consumo</h1>
        <p class="text-muted">
            Informações do consumo e do veículo relacionado.
        </p>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0">Dados do consumo</h5>
        </div>

        <div class="card-body p-4">
            <div class="row g-3">

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <small class="text-muted">Identificador</small>
                        <div class="fw-semibold">#@Model.Id</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <small class="text-muted">Descrição</small>
                        <div class="fw-semibold">
                            @Model.Descricao
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <small class="text-muted">Data</small>
                        <div class="fw-semibold">
                            @Model.Data.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <small class="text-muted">Valor</small>
                        <div class="fw-bold text-success fs-5">
                            @Model.Valor.ToString("C2",
                                System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <small class="text-muted">Quilometragem</small>
                        <div class="fw-semibold">
                            @Model.km.ToString("N0") km
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <small class="text-muted">Tipo de combustível</small>
                        <div class="fw-semibold">
                            @Model.TipoCombustivel
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0">Dados do veículo</h5>
        </div>

        <div class="card-body p-4">

            @if (Model.Veiculo != null)
            {
                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <small class="text-muted">ID do veículo</small>
                            <div class="fw-semibold">
                                @Model.VeiculoId
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <small class="text-muted">Nome</small>
                            <div class="fw-semibold">
                                @Model.Veiculo.Nome
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <small class="text-muted">Placa</small>
                            <div class="fw-semibold">
                                @Model.Veiculo.Placa
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <small class="text-muted">Ano de Fabricação</small>
                            <div class="fw-semibold">
                                @Model.Veiculo.AnoFabricacao
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <small class="text-muted">Ano do Modelo</small>
                            <div class="fw-semibold">
                                @Model.Veiculo.AnoModelo
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    Não foi possível carregar os dados do veículo relacionado.
                </div>
            }

        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Apagar Consumo
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Voltar para a lista
        </a>
    </div>

</div>
