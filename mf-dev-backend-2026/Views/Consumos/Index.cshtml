@model IEnumerable<mf_dev_backend_2026.Models.Consumo>

@{
    ViewData["Title"] = "Index";
}

<h1>Consumos</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Adicionar novo Consumo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Data)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Valor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.km)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipoCombustivel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Veiculo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Descricao)
            </td>
            <td>
                @Html.DisplayFor(model => item.Data)
            </td>
            <td>
                @Html.DisplayFor(model => item.Valor)
            </td>
            <td>
                @Html.DisplayFor(model => item.km)
            </td>
            <td>
                @Html.DisplayFor(model => item.TipoCombustivel)
            </td>
            <td>
                @Html.DisplayFor(model => item.Veiculo.Nome)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar Consumo</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Visualizar Consumo</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Apagar Consumo</a>
            </td>
        </tr>
}
    </tbody>
</table>
