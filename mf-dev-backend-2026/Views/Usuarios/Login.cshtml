@model mf_dev_backend_2026.Models.Usuario

@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-controller="Usuarios"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Id" class="control-label">
                    Código do usuário
                </label>

                <input asp-for="Id"
                       type="number"
                       class="form-control"
                       required />

                <span asp-validation-for="Id"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Senha" class="control-label">
                    Senha
                </label>

                <input asp-for="Senha"
                       type="password"
                       class="form-control"
                       required />

                <span asp-validation-for="Senha"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Acessar"
                       class="btn btn-success" />
            </div>

        </form>

        @if (ViewBag.Mensagem != null)
        {
            <div class="alert alert-danger mt-3">
                @ViewBag.Mensagem
            </div>
        }

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}